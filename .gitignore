node_modules
dist
*.tmp

# Secrets — never commit. The agent reads ANTHROPIC_API_KEY from here.
.env
.env.*
!.env.example
# Embedded terminal's subscription credential (built by scripts/terminal-setup-cred.mjs).
.terminal/
.DS_Store
tickets/
events/
runs/
# Local recorder output — real demo traces live with the viewer (portfolio site),
# never in this repo. The committed schema fixture is test-support/sampleTrace.json.
traces/
# Session-retrospective proposals quote private transcripts (tkt-4cda7a4ab619).
retros/
test-results/
playwright-report/
coverage/
.cache/

# Claude Code per-session worktrees live here (tkt-4b74943a319e) — checkouts, never sources.
.claude/worktrees

# Machine-local skill config: absolute repo paths + private project names.
# The tracked SKILL.md must stay free of both (hardpack is a public repo).
.claude/skills/**/*.local.*
# Machine-local Claude Code permissions + env — broader than the tracked settings.json (tkt-77b6c8d57b11).
.claude/settings.local.json

# Night-run sentinel + logs — machine-local runtime state, never committed (tkt-1e6a129c8d7f)
.night-run

# Test fixture roots. Kept inside the repo rather than os.tmpdir() so no suite writes outside the
# workspace; each suite mkdtemps its own subdirectory here and removes it.
.tmp-test
