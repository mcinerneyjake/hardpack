{
  "name": "hardpack",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/preflight-dev.mjs",
    "dev": "concurrently -n server,web -c blue,green \"npm run server\" \"vite\"",
    "server": "KANBAN_TERMINAL=1 tsx watch server/index.ts",
    "agent": "tsx agent/index.ts",
    "agent:search": "tsx agent/searchDemo.ts",
    "agent:record": "tsx agent/recordRun.ts",
    "retro": "tsx agent/retro/cli.ts",
    "eval:retrieval": "tsx agent/eval/retrievalEval.ts",
    "terminal:clean": "tsx scripts/terminal-clean.ts",
    "ticket": "tsx scripts/ticket.ts",
    "night": "node scripts/night-run.mjs",
    "night:start": "node --env-file-if-exists=.env scripts/night-control.mjs start",
    "night:status": "node --env-file-if-exists=.env scripts/night-control.mjs status",
    "night:stop": "node --env-file-if-exists=.env scripts/night-control.mjs stop",
    "night:report": "node scripts/night-report.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "review": "node scripts/review.mjs",
    "seed": "node scripts/seed.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "prepare": "husky",
    "postinstall": "node scripts/fix-node-pty-perms.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.14",
    "express": "^4.19.2",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.11",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ticket-workflow": "github:mcinerneyjake/ticket-workflow#v0.29.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.25",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.9"
  }
}
